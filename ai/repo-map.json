        "docs/PUBLIC_EXPORT_CONTRACT.md",
        "harness/public_export_required.json"
      ],
      "expand_on_failure": [
        "tests/test_public_export_contract.py",
        "docs/SKILL_SYSTEM.md",
        "AGENTS.md"
      ]
    },
    "windows_installation": {
      "primary": [
        "installation/README.md",
        "Start_CAH.bat",
        "browser/playwright/README.md"
      ],
      "expand_on_failure": [
        "Start_CAH.ps1",
        "host/bridge_supervisor.ps1",
        "host/install_playwright_tools.ps1",
        "host/playwright-tools/package.json",
        "docs/PUBLIC_EXPORT_CONTRACT.md"
      ]
    },
    "lane_maintenance": {
      "primary": [
        "docs/LIFECYCLE_MAINTENANCE.md"
      ],
      "expand_on_failure": [
        "playwright_host/runtime.py",
        "local_bridge/control.py",
        "local_bridge/server.py",
        "docs/CONVERSATION_POOL.md"
      ]
    },
    "context_economy": {
      "primary": [
        "docs/CONTEXT_ECONOMY.md"
      ],
      "expand_on_failure": [
        "docs/CONTINUITY.md",
        "docs/SKILL_SYSTEM.md",
        "docs/PUBLIC_EXPORT_CONTRACT.md",
        "ai/repo-map.json"
      ]
    },
    "host_capabilities": {
      "primary": [
        "docs/HOST_CAPABILITIES.md",
        "harness/host_capability.schema.json"
      ],
      "expand_on_failure": [
        "host/capabilities.py",
        "executors/host_capability.py",
        "harness/resource_wait.py",
        "harness/cl.schema.json",
        "tests/test_host_capabilities.py"
      ]
    },
    "foreground_delivery_debug": {
      "primary": [
        "docs/FOREGROUND_MONITOR.md",
        "browser/playwright/README.md"
      ],
      "expand_on_failure": [
        "playwright_host/runtime.py",
        "playwright_host/ui.py",
        "local_bridge/server.py",
        "playwright_host/worker.py",
        "host/start_playwright_host.ps1"
      ]
    },
    "record_archive": {
      "primary": [
        "state/record-store.json",
        "docs/RECORD_ARCHIVE.md"
      ],
      "expand_on_failure": [
        "docs/CLEANER_RULES.md"
      ]
    },
    "tool_runtime": {
      "primary": [
        "harness/tools/registry.json",
        "docs/TOOL_SYSTEM.md"
      ],
      "expand_on_failure": [
        "harness/tool.schema.json",
        "harness/tool_runtime.py",
        "playwright_host/mcp.py",
        "playwright_host/worker.py",
        "playwright_host/runtime.py",
        "tests/test_tool_runtime.py",
        "tests/test_playwright_mcp.py"
      ]
    }
  },
  "parallelism": {
    "safe_examples": [
      [
        "harness/",
        "executors/"
      ],
      [
        "playwright_host/runtime.py",
        "executors/"
      ],
      [
        "docs/",
        "tests/"
      ]
    ],
    "coordination_required": [
      "state/chatgpt.json",
      "AGENTS.md",
      "harness/*.schema.json",
      "local_bridge/server.py",
      "playwright_host/runtime.py",
      "playwright_host/worker.py"
    ]
  }
}
