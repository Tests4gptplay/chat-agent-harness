{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessWake",
  "type": "object",
  "required": [
    "v",
    "wake_id",
    "project_id",
    "state",
    "created_at"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "wake_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "enum": [
        "NEED_AGENT",
        "NEED_USER",
        "BLOCKED",
        "DONE"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "maxLength": 512
    },
    "run_id": {
      "type": "string",
      "maxLength": 512
    },
    "result_ref": {
      "type": "string",
      "maxLength": 512
    },
    "lane_id": {
      "type": "string",
      "pattern": "^lane-[0-9]{2,}$"
    },
    "worker_project_key": {
      "type": "string",
      "pattern": "^g-p-[A-Za-z0-9]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backend_cl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "dispatch_generation": {
      "type": "integer",
      "minimum": 1
    },
    "fence_token": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "attachment_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._/-]+$"
    }
  },
  "additionalProperties": false
}
