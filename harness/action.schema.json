{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessAction",
  "type": "object",
  "required": [
    "v",
    "action_id",
    "task_id",
    "round",
    "executor",
    "operation",
    "payload",
    "expected_evidence"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "foreground_cl": {
      "type": "string",
      "minLength": 1
    },
    "backend_cl": {
      "type": "string",
      "minLength": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21600
    },
    "lane_id": {
      "type": "string",
      "pattern": "^lane-[0-9]{2,}$"
    },
    "worker_project_key": {
      "type": "string",
      "pattern": "^g-p-[A-Za-z0-9]+$"
    },
    "worker_continuation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
