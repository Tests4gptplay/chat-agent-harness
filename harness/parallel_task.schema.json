{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAHParallelTask",
  "type": "object",
  "required": [
    "v",
    "task_id",
    "max_parallel",
    "nodes"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "depends_on"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
