{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessResult",
  "type": "object",
  "required": [
    "v",
    "result_id",
    "action_id",
    "task_id",
    "round",
    "status",
    "summary",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {},
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fault_boundary": {
      "type": "string"
    },
    "log_excerpt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
