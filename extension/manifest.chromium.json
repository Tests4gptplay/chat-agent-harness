{
  "manifest_version": 3,
  "name": "CAH Wake Bridge",
  "version": "1.0.4",
  "description": "CAH control + execution browser host with a protected Task Cell and independent 5+1 backend lanes.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background_bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "worker_retirement_content.js",
        "worker_content.js",
        "worker_root_content.js",
        "history_rate_limit.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CAH Wake Bridge",
    "default_icon": {
      "16": "icons/cah-icon-16.png",
      "24": "icons/cah-icon-24.png",
      "32": "icons/cah-icon-32.png"
    }
  },
  "icons": {
    "16": "icons/cah-icon-transparent.png",
    "32": "icons/cah-icon-transparent.png",
    "48": "icons/cah-icon-transparent.png",
    "128": "icons/cah-icon-transparent.png"
  }
}
